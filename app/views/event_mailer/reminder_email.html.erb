<h2 style="margin-bottom: 8px;">Reminder: <%= @title %></h2>
<p>Hi <%= @user.person.display_name %>,</p>
<p>
  This is a reminder for an upcoming event:
</p>
<p style="margin: 24px 0; padding: 16px; background: #f5f5f5; border-radius: 8px;">
  <strong><%= @title %></strong><br>
  <%= @starts_at.in_time_zone(@display_timezone).strftime('%A, %B %-d at %-I:%M %p %Z') %>
  &ndash; <%= @ends_at.in_time_zone(@display_timezone).strftime('%-I:%M %p %Z') %>
  <% if @location.present? %>
    <br><%= @location %>
  <% end %>
</p>
<p style="margin: 32px 0;">
  <a href="<%= @event_url %>"
     style="background: #1a1a1a; color: #ffffff; padding: 12px 20px; text-decoration: none; border-radius: 6px; display: inline-block;">
    View event
  </a>
</p>
