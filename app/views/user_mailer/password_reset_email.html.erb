<h2 style="margin-bottom: 8px;">Reset your password</h2>
<p>Hi <%= @person.display_name %>,</p>
<p>We received a request to reset your password.</p>
<p style="margin: 32px 0;">
  <a href="<%= @reset_url %>"
     style="background: #1a1a1a; color: #ffffff; padding: 12px 20px; text-decoration: none; border-radius: 6px; display: inline-block;">
    Reset password
  </a>
</p>
<p style="font-size: 13px; color: #6a6a6a;">This link expires in 20 minutes.</p>
<p style="font-size: 13px; color: #6a6a6a;">
  Or paste this into your browser: <%= @reset_url %>
</p>
<p style="font-size: 13px; color: #6a6a6a;">
  Didn't request this? Your password hasn't been changed - you can ignore this email.
</p>
